# Copy to secrets.properties (git-ignored) and fill in after creating your Google Cloud OAuth clients.
# Web application OAuth client ID (used to get the signed-in user's Google identity):
GOOGLE_WEB_CLIENT_ID=
# The committee's Google Sheet (full link or just the id). Fixed in the build; the app never asks for it.
# You may instead export it as the SPREADSHEET_URL environment variable.
SPREADSHEET_URL=

# Only for the import-workbook skill (never built into the app). Use ONE of these:
#  a) the existing Web client's secret (also add http://localhost:8765 under that client's "Authorized redirect URIs"):
# GOOGLE_WEB_CLIENT_SECRET=...
#  b) a separate OAuth client of type "Desktop app" (no redirect setup needed):
# DESKTOP_CLIENT_ID=...
# DESKTOP_CLIENT_SECRET=...
